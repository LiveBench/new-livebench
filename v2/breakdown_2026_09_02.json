  "Browser": {
    "parts": [
      {
        "name": "Data Aggregation",
        "gloss": "Exhaustive traversal of a large record set and multi-part roll-ups."
      },
      {
        "name": "Sequential Planning",
        "gloss": "Order-dependent steps where each step constrains the next."
      },
      {
        "name": "Analysis-Driven Action",
        "gloss": "Derive a result from the data, then act on it in the app."
      },
      {
        "name": "Structural Integrity",
        "gloss": "Keep a document or record graph consistent across an edit."
      },
      {
        "name": "Constraint Adherence",
        "gloss": "Exact fidelity, plus correctly declining what the app won't permit."
      }
    ],
